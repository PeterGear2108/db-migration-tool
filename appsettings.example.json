{
  "SourceEngine": "SqlServer",
  "TargetEngine": "SqlServer",
  "ConnectionStrings": {
    "Production": "Server=localhost;Database=source_database;Integrated Security=True;TrustServerCertificate=True;",
    "Test": "Server=localhost;Database=target_database;Integrated Security=True;TrustServerCertificate=True;"
  },
  "MigrationSettings": {
    "DryRun": true,
    "ConfirmBeforeTruncate": true,
    "ContinueOnError": false,
    "EnableIdentityInsert": true,
    "DestructiveReload": false,
    "BatchSize": 1000
  },
  "AlwaysExcludedTables": [
    "Sales",
    "SalesOrderDetail",
    "Invoices"
  ],
  "SelectedTableNames": null,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  }
}
